{
    "name": "@peppermint-digital/mailbox",
    "version": "0.148.0",
    "description": "Mail browser logic to go with the PHP package: quoting an original message, without a word of user-facing text.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inertia": {
            "types": "./dist/inertia/index.d.ts",
            "import": "./dist/inertia/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.7.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "jsdom": "^30.0.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "@inertiajs/react": "^2 || ^3",
        "@tiptap/extension-color": "^3.31.0",
        "@tiptap/extension-highlight": "^3.31.0",
        "@tiptap/extension-image": "^3.31.0",
        "@tiptap/extension-link": "^3.31.0",
        "@tiptap/extension-placeholder": "^3.31.0",
        "@tiptap/extension-table": "^3.31.0",
        "@tiptap/extension-table-cell": "^3.31.0",
        "@tiptap/extension-table-header": "^3.31.0",
        "@tiptap/extension-table-row": "^3.31.0",
        "@tiptap/extension-text-align": "^3.31.0",
        "@tiptap/extension-text-style": "^3.31.0",
        "@tiptap/extension-underline": "^3.31.0",
        "@tiptap/react": "^3.31.0",
        "@tiptap/starter-kit": "^3.31.0",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "dependencies": {
        "@radix-ui/react-checkbox": "^1.3.11",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.2.16",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.45.0",
        "tailwind-merge": "^3.2.0"
    },
    "peerDependenciesMeta": {
        "@inertiajs/react": {
            "optional": true
        }
    },
    "overrides": {
        "source-map-js": "^1.2.2"
    }
